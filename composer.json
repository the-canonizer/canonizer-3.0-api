{
    "name": "laravel/lumen",
    "description": "The Laravel Lumen Framework.",
    "keywords": [
        "framework",
        "laravel",
        "lumen"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.3|^8.0",
        "abraham/twitteroauth": "^3.3",
        "anik/form-request": "^4.3",
        "doctrine/annotations": "*",
        "doctrine/dbal": "^3.3",
        "doctrine/lexer": "*",
        "dusterio/lumen-passport": "^0.3.0",
        "elasticsearch/elasticsearch": "^8.10",
        "flipbox/lumen-generator": "^8.2",
        "google/apiclient": "^2.15",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/mail": "^8.81",
        "illuminate/redis": "^8.83",
        "laravel/lumen-framework": "^8.3.1",
        "laravel/socialite": "^5.3",
        "league/flysystem-aws-s3-v3": "~1.0",
        "mingalevme/illuminate-uqueue": "^1.2",
        "predis/predis": "^2.2",
        "spatie/laravel-activitylog": "^3.17",
        "aws/aws-sdk-php": "3.283.13"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "phpunit/phpunit": "^9.5.10",
        "zircote/swagger-php": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "App\\Swagger\\": "app/Swagger/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "ignore": [
                "PKSA-4s4z-t146-6123",
                "PKSA-dxyf-6n16-t87m",
                "PKSA-n3s6-289w-qtqb",
                "PKSA-stsw-jsf7-f6vs"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}